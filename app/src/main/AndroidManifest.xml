<?xml version="1.0" encoding="utf-8"?>
<!--
  OriginOS Toolkit — minimal permission set.

  SECURITY.md promises that this list never grows silently: the CI workflow
  .github/workflows/android.yml fails the build if a new <uses-permission>
  appears without a matching entry in docs/PERMISSIONS.md.

  There is deliberately no INTERNET permission. The app cannot phone home.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Draw the FPS / refresh-rate overlay on top of other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The no-Shizuku path.

      WRITE_SETTINGS is what lets the app write the `system` settings namespace
      itself, once the user flips the "modify system settings" switch. It reaches
      that one namespace and nothing else: Settings.Secure and Settings.Global
      stay out of reach, so it is not a substitute for WRITE_SECURE_SETTINGS and
      cannot be used to change anything the shell user alone could change.

      Declared here because `Settings.System.putString` is checked against the
      manifest; the switch in Settings is what actually grants it.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Detect which app is in the foreground, for per-app refresh-rate profiles. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Enumerate packages so the debloat list can show what is installed. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Long-running overlay and per-app refresh watcher. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Shizuku: the only path to privileged shell commands. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".OriginOsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OriginOSToolkit"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OriginOSToolkit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Watches the foreground app and applies its refresh-rate profile. -->
        <service
            android:name=".service.PerAppRefreshService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the display refresh rate in sync with the app the user chose for it." />
        </service>

        <!-- Draws the FPS / refresh meter over the current app. -->
        <service
            android:name=".service.FpsOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Renders a user-requested frame-rate overlay above other apps." />
        </service>

        <!--
          The island re-caster: notifications from the apps the user picked on
          the Island tab are re-posted as `notification.superx.*` casts. Only
          the system may bind to it (the BIND permission is android's), and the
          user still has to grant *notification access* in system settings —
          an install-time permission this manifest deliberately does not claim.
        -->
        <service
            android:name=".service.IslandCastListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          The Shizuku user service. Shizuku starts this component in its own
          process, running as the shell user (uid 2000): everything the toolkit
          changes happens in here. `processNameSuffix("service")` on the client
          side is what makes the process name match `:service`.
        -->
        <service
            android:name=".core.shell.UserService"
            android:exported="false"
            android:process=":service" />

        <!--
          The home-screen components (OriginOS calls the same thing an atomic
          component): a 2×2 refresh-rate switch and a 4×2 status tile.

          Neither is exported, and neither declares a permission. The refresh
          tile's chip sends an explicit intent at *this* package from a
          PendingIntent this app created, so it is delivered here and nowhere
          else; the launcher never gets to name a target.
        -->
        <receiver
            android:name=".widget.RefreshWidgetProvider"
            android:exported="false"
            android:label="@string/widget_refresh_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_refresh_info" />
        </receiver>

        <receiver
            android:name=".widget.ToolkitWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_toolkit_info" />
        </receiver>

        <!-- Shizuku's binder bridge. Required by dev.rikka.shizuku:provider. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
