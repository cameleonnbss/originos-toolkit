        android:pathData="M36,36 m-26.4,0 a26.4,26.4 0 1,0 52.8,0 a26.4,26.4 0 1,0 -52.8,0
                          M36,36 m-18.8,0 a18.8,18.8 0 1,0 37.6,0 a18.8,18.8 0 1,0 -37.6,0">
