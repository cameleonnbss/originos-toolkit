<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The whole UI is Compose, so this theme only has to get out of the way:
      no action bar, a dark window background to avoid a white flash at launch,
      and transparent system bars (edge-to-edge is enabled from MainActivity).
    -->
    <style name="Theme.OriginOSToolkit" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
