<?xml version="1.0" encoding="utf-8"?>
<!--
  The few colours the XML side needs. Everything else lives in Theme.kt, because
  the whole UI is Compose; these exist only so themes.xml and the notification
  accent have something to point at before the first frame is composed.

  `surface` is the launch-window background: the value in this folder is the
  light one, and values-night/colors.xml overrides it so a launch never flashes
  the wrong end of the theme.
-->
<resources>
    <color name="surface">#F1F3F6</color>
    <color name="accent">#1A6DFF</color>

    <!-- Ends of the OriginOS sweep. Kept here for the swept wordmark underline. -->
    <color name="brand_coral">#FF5E4A</color>
    <color name="brand_violet">#A94ED6</color>

    <!--
      The home-screen components.

      These are the only colours the XML side needs beyond the launch window, and
      they follow the same rules as the Compose theme: a translucent panel that
      lets the wallpaper through, a hairline edge instead of a shadow, muted
      labels, and exactly one accent — the chip that does something.

      Every one of them has a dark counterpart in values-night/, because a
      launcher that is in dark mode resolves them in the host's configuration.
    -->
    <color name="widget_card">#E6FBFCFE</color>
    <color name="widget_hairline">#1A101418</color>
    <color name="widget_text">#FF101418</color>
    <color name="widget_muted">#FF59616E</color>
    <color name="widget_chip">#14101418</color>
    <color name="widget_accent">#FF1A6DFF</color>
    <color name="widget_action_text">#FFFFFFFF</color>
</resources>
