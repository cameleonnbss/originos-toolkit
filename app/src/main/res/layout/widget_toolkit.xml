<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2 status atomic component: which phone this is, how it is being reached,
  and the three numbers the Home tab leads with.

  Everything it shows is readable without the shell user, on purpose: a widget
  that made Shizuku spin up its helper process just to draw a label would be a
  worse citizen than one that cannot show the OriginOS build number.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_toolkit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_toolkit_mark"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_logo_ring" />

        <TextView
            android:id="@+id/widget_toolkit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="vivo X300 Pro" />

        <TextView
            android:id="@+id/widget_toolkit_access"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textAllCaps="true"
            android:textColor="@color/widget_muted"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="NO SHIZUKU" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_toolkit_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="10sp"
        tools:text="Android 16 · 120 Hz panel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_toolkit_density_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="460" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/widget_toolkit_stat_density"
                android:textAllCaps="true"
                android:textColor="@color/widget_muted"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_toolkit_panel_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="120" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/widget_toolkit_stat_panel"
                android:textAllCaps="true"
                android:textColor="@color/widget_muted"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_toolkit_applied_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/widget_toolkit_stat_applied"
                android:textAllCaps="true"
                android:textColor="@color/widget_muted"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
